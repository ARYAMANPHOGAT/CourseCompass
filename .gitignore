# Python
backend/.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.coverage
htmlcov/

# Node / Vite
frontend/node_modules/
frontend/dist/
frontend/node_modules/.tmp/
*.tsbuildinfo
npm-debug.log*

# Runtime user data (created on first run; safe demo data lives elsewhere)
backend/data/user/*
!backend/data/user/.gitkeep

# Raw dataset: redistribution terms are not documented, keep it out of version control
backend/data/raw/*.csv

# Local overrides and secrets
frontend/.env
frontend/.env.*
!frontend/.env.example
frontend/.env.local
.env.local
*.local

# Editors / OS
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
.DS_Store
Thumbs.db
